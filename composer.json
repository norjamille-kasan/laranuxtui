{
    "$schema": "https://getcomposer.org/schema.json",
    "name": "norjamille-kasan/laravel-starter-kit-nuxt-ui",
    "type": "project",
    "description": "An opinionated, type-safe Laravel starter kit based on Nuno Maduro's Inertia & Vue starter kit, rebuilt with Nuxt UI.",
    "keywords": [
        "laravel",
        "framework",
        "inertia",
        "vue",
        "nuxt-ui",
        "starter-kit",
        "typescript"
    ],
    "license": "MIT",
    "authors": [
        {
            "name": "Jam",
            "email": "jamclong0328@gmail.com"
        }
    ],
    "homepage": "https://github.com/norjamille-kasan/laranuxtui",
    "support": {
        "issues": "https://github.com/norjamille-kasan/laranuxtui/issues",
        "source": "https://github.com/norjamille-kasan/laranuxtui"
    },
    "require": {
        "php": "^8.4.0",
        "inertiajs/inertia-laravel": "^3.7.0",
        "laravel/fortify": "^1.42.0",
        "laravel/framework": "^13.42.0",
        "laravel/tinker": "^3.1.0",
        "laravel/wayfinder": "^0.1.23",
        "nunomaduro/essentials": "^1.2.0"
    },
    "require-dev": {
        "driftingly/rector-laravel": "^2.7.3",
        "fakerphp/faker": "^1.24.1",
        "larastan/larastan": "^3.14.0",
        "laravel/boost": "^2.10.4",
        "laravel/pail": "^1.3.0",
        "laravel/pint": "^1.32.2",
        "laravel/telescope": "^5.28",
        "mockery/mockery": "^1.6.15",
        "nunomaduro/collision": "^8.9.6",
        "pestphp/pest": "^5.3.5",
        "pestphp/pest-plugin-browser": "^5.2",
        "pestphp/pest-plugin-laravel": "^5.0.1",
        "pestphp/pest-plugin-type-coverage": "^5.1",
        "rector/rector": "^2.8.4",
        "roave/security-advisories": "dev-latest"
    },
    "autoload": {
        "psr-4": {
            "App\\": "app/",
            "Database\\Factories\\": "database/factories/",
            "Database\\Seeders\\": "database/seeders/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Tests\\": "tests/"
        }
    },
    "scripts": {
        "setup": [
            "composer install",
            "@php -r \"file_exists('.env') || copy('.env.example', '.env');\"",
            "@php artisan key:generate",
            "@php artisan migrate --force",
            "bun install",
            "bun run build"
        ],
        "dev": [
            "Composer\\Config::disableProcessTimeout",
            "bunx concurrently -c \"#93c5fd,#c4b5fd,#fb7185,#fdba74\" \"php artisan serve\" \"php artisan queue:listen --tries=1\" \"php artisan pail --timeout=0\" \"bun run dev\" --names=server,queue,logs,vite --kill-others"
        ],
        "post-autoload-dump": [
            "Illuminate\\Foundation\\ComposerScripts::postAutoloadDump",
            "@php artisan package:discover --ansi"
        ],
        "post-update-cmd": [
            "@php artisan vendor:publish --tag=laravel-assets --ansi --force",
            "@php artisan clear",
            "@update:requirements",
            "@php artisan boost:update --ansi || true"
        ],
        "post-root-package-install": [
            "@php -r \"file_exists('.env') || copy('.env.example', '.env');\""
        ],
        "post-create-project-cmd": [
            "@php artisan key:generate --ansi",
            "@php -r \"file_exists('database/database.sqlite') || touch('database/database.sqlite');\"",
            "@php artisan migrate --graceful --ansi || true"
        ],
        "update:requirements": [
            "composer bump",
            "bunx npm-check-updates -u"
        ],
        "lint": [
            "rector",
            "pint --parallel",
            "bun run lint"
        ],
        "test:type-coverage": "php -d memory_limit=1G vendor/bin/pest --type-coverage --min=100",
        "test:lint": [
            "pint --parallel --test",
            "rector --dry-run",
            "bun run test:lint"
        ],
        "test:unit": "XDEBUG_MODE=\"coverage\" php -d memory_limit=1G vendor/bin/pest --parallel --coverage --exactly=100.0",
        "test:types": [
            "phpstan --memory-limit=1G",
            "bun run test:types"
        ],
        "test": [
            "@test:type-coverage",
            "@test:unit",
            "@test:lint",
            "@test:types"
        ]
    },
    "extra": {
        "laravel": {
            "dont-discover": [
                 "laravel/telescope"
            ]
        }
    },
    "config": {
        "optimize-autoloader": true,
        "preferred-install": "dist",
        "sort-packages": true,
        "allow-plugins": {
            "pestphp/pest-plugin": true,
            "php-http/discovery": true
        }
    },
    "minimum-stability": "dev",
    "prefer-stable": true
}
